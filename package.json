{
  "name": "media-downloader",
  "version": "0.1.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/setup.mjs",
    "electron-start": "electron .",
    "clean": "rmdir /s /q .next 2>nul & rmdir /s /q out 2>nul & echo Cleaned",
    "build:mobile": "node build-mobile.js",
    "dist": "npm run clean && next build && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "better-sqlite3": "^13.0.3",
    "cakkatrok-instagram-downloader": "^2.0.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "instagram-url-direct": "^2.0.7",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "snapsave-media-downloader": "^2.4.1",
    "uuid": "^14.0.2",
    "youtube-dl-exec": "^3.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jest": "^30.4.2",
    "tailwindcss": "^4"
  },
  "build": {
    "appId": "com.mediadownloader.app",
    "productName": "MediaDownloader",
    "win": {
      "target": "nsis"
    },
    "files": [
      "electron-main.js",
      "package.json",
      ".next/**/*",
      "!.next/cache/**/*",
      "public/**/*",
      "node_modules/**/*"
    ]
  }
}
